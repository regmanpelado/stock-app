# ── Binance ───────────────────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# ── Coinbase Advanced Trade (CDP) ─────────────────────────────────────────────
# API Key formato: organizations/xxx/apiKeys/xxx
# Secret: clave EC privada PEM en una sola linea con \n literales
COINBASE_API_KEY=organizations/xxx/apiKeys/xxx
COINBASE_SECRET_KEY=-----BEGIN EC PRIVATE KEY-----\nMHc...\n-----END EC PRIVATE KEY-----\n

# ── Kraken ────────────────────────────────────────────────────────────────────
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET_KEY=your_kraken_secret_key_here

# ── Gate.io ───────────────────────────────────────────────────────────────────
GATE_API_KEY=your_gate_api_key_here
GATE_SECRET_KEY=your_gate_secret_key_here

# ── App ───────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false

# ALLOWED_ORIGINS: en producción, pon la URL pública del frontend en Railway
# Ejemplo: https://crypto-app-frontend.up.railway.app
# En desarrollo: http://localhost:3000,http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
